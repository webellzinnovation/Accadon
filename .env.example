# Server only. Never use VITE_ for database credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/accadon
PORT=3001
# Production requires a valid Postgres TLS configuration in DATABASE_URL.
# Keep NODE_ENV unset during local development.
# NODE_ENV=production
# Exact HTTPS public origin at deployment; no trailing slash.
# PUBLIC_ORIGIN=https://your-approved-host.example
